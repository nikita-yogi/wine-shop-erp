model product_meta {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique(map: "uuid") @default(uuid()) @db.Char(36)
  product_id Int
  meta_key   String    @db.VarChar(100)
  meta_value String?   @db.Text
  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_product_meta_product")

  @@index([product_id], map: "fk_product_meta_product")
}




