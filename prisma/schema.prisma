generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model roles {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid()) @db.Char(36)
  name       String    @unique @db.VarChar(50)
  status     Status    @default(active)
  created_at DateTime  @default(now())
  deleted_at DateTime?
  users      users[]

  @@map("roles")
}

model permission {
  id               Int                @id @default(autoincrement())
  uuid             String             @unique @default(uuid()) @db.Char(36)
  name             String             @unique @db.VarChar(100)
  group            String?            @db.VarChar(50)
  status           Status             @default(active)
  description      String?            @db.Text
  created_at       DateTime           @default(now())
  deleted_at       DateTime?
  user_permissions user_permissions[]

  @@map("permissions")
}

model users {
  id            Int                @id @default(autoincrement())
  uuid          String             @unique @default(uuid()) @db.Char(36)
  name          String             @db.VarChar(150)
  email         String             @unique @db.VarChar(150)
  phone         String?            @unique @db.VarChar(20)
  address       String?            @db.VarChar(150)
  city          String?            @db.VarChar(100)
  state         String?            @db.VarChar(100)
  password      String             @db.Text
  date_of_birth DateTime?          @db.Date
  role_id       Int?
  status        Status             @default(active)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  deleted_at    DateTime?
  sessions      session[]
  meta          user_meta[]
  permissions   user_permissions[]
  role          roles?             @relation(fields: [role_id], references: [id], map: "users_roleId_fkey")

  password_otps password_otp[]

  @@index([role_id], map: "users_roleId_idx")
  @@map("users")
}

model user_meta {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid()) @db.Char(36)
  user_id    Int
  meta_key   String    @db.VarChar(100)
  meta_value String?   @db.Text
  created_at DateTime  @default(now())
  deleted_at DateTime?
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "user_meta_userId_fkey")

  @@index([user_id], map: "user_meta_userId_fkey")
  @@map("user_meta")
}

model user_permissions {
  id            Int        @id @default(autoincrement())
  uuid          String     @unique @default(uuid()) @db.Char(36)
  user_id       Int
  permission_id Int
  created_at    DateTime   @default(now())
  deleted_at    DateTime?
  permission    permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "user_permissions_permissionId_fkey")
  user          users      @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "user_permissions_userId_fkey")

  @@unique([user_id, permission_id], map: "uq_user_permission")
  @@index([permission_id], map: "user_permissions_permissionId_fkey")
  @@map("user_permissions")
}

model session {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique(map: "user_sessions_uuid_key") @default(uuid()) @db.Char(36)
  user_id       Int
  session_token String    @unique(map: "user_sessions_sessionToken_key") @db.VarChar(512)
  ip_address    String?   @db.VarChar(45)
  user_agent    String?   @db.Text
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  revoked_at    DateTime?
  expires_at    DateTime
  deleted_at    DateTime?
  user          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "user_sessions_userId_fkey")

  @@index([user_id], map: "idx_sessions_user")
  @@index([is_active], map: "idx_sessions_active")
  @@map("session")
}

model password_otp {
  id            Int       @id @default(autoincrement())
  user_id       Int
  email         String    @db.VarChar(255)
  otp           String    @db.VarChar(6)
  is_used       Boolean   @default(false)
  expires_at    DateTime
  created_at    DateTime  @default(now())
  deleted_at    DateTime?
  attempts      Int       @default(0)
  blocked_until DateTime?

  // Relation with existing users table (Assuming model name is 'users')
  user users @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([email])
}

model stores {
  id          Int           @id @default(autoincrement())
  uuid        String        @unique @default(uuid()) @db.Char(36)
  name        String        @db.VarChar(150)
  code        String        @unique @db.VarChar(50)
  license_no  String?       @unique @db.VarChar(100)
  expiry_date DateTime?     @db.Date
  address     String?       @db.VarChar(255)
  city        String?       @db.VarChar(100)
  state       String?       @db.VarChar(100)
  pincode     String?       @db.VarChar(10)
  status      stores_status @default(open)
  phone_no    String?       @db.VarChar(20)
  email       String?       @db.VarChar(150)
  tax_rate    Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  deleted_at  DateTime?

  store_products  store_products[]
  audit_logs      audit_logs[]
  orders          orders[]
  purchase_orders purchase_orders[]

  @@index([status], map: "idx_stores_status")
  @@index([city], map: "idx_stores_city")
  @@map("stores")
}

model brands {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Char(36)

  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  status Status @default(active)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  products products[]

  @@map("brands")
}

model categories {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Char(36)

  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  status Status @default(active)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  products products[]

  @@map("categories")
}

model product_types {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Char(36)

  name String @unique @db.VarChar(100)

  volume_ml  Decimal? @db.Decimal(10, 2)
  unit       String?  @db.VarChar(50)
  unit_value Decimal? @db.Decimal(10, 2)

  status Status @default(active)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  products products[]

  @@map("product_types")
}

model products {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Char(36)

  name        String  @db.VarChar(150)
  description String? @db.VarChar(255)

  sku     String  @unique @db.VarChar(100)
  barcode String? @unique @db.VarChar(100)

  brand_id        Int
  category_id     Int
  product_type_id Int

  status Status @default(active)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  brand brands @relation(fields: [brand_id], references: [id], onDelete: Restrict)

  category categories @relation(fields: [category_id], references: [id], onDelete: Restrict)

  product_type product_types @relation(fields: [product_type_id], references: [id], onDelete: Restrict)

  product_meta product_meta[]

  store_products store_products[]

  purchase_order_items purchase_order_items[]

  @@index([brand_id])
  @@index([category_id])
  @@index([product_type_id])
  @@index([name])
  @@map("products")
}

model product_meta {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Char(36)

  product_id Int

  meta_key   String  @db.VarChar(100)
  meta_value String? @db.Text

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, meta_key])
  @@index([product_id])
  @@map("product_meta")
}

model store_products {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Char(36)

  store_id   Int
  product_id Int

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  order_items order_items[]

  store stores @relation(fields: [store_id], references: [id], onDelete: Restrict)

  product products @relation(fields: [product_id], references: [id], onDelete: Restrict)

  store_product_batches store_product_batches[]

  @@unique([store_id, product_id])
  @@index([product_id])
  @@map("store_products")
}

model store_product_batches {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid()) @db.Char(36)

  batch_number String @db.VarChar(100)

  store_product_id Int

  purchase_price Decimal @db.Decimal(12, 2)
  selling_price  Decimal @db.Decimal(12, 2)
  quantity       Decimal @default(0) @db.Decimal(12, 2)

  expiry_date      DateTime? @db.Date
  manufacture_date DateTime? @db.Date

  supplier_id Int?

  created_at DateTime  @default(now())
  deleted_at DateTime?

  supplier suppliers? @relation(fields: [supplier_id], references: [id], onDelete: Restrict)

  store_product store_products @relation(fields: [store_product_id], references: [id], onDelete: Restrict)

  order_items          order_items[]
  purchase_order_items purchase_order_items[]

  @@unique([store_product_id, batch_number])
  @@index([store_product_id])
  @@index([supplier_id])
  @@index([batch_number])
  @@map("store_product_batches")
}

model audit_logs {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique(map: "uuid") @default(uuid()) @db.Char(36)
  user_id     Int?
  store_id    Int?
  action      String    @db.VarChar(50)
  entity_type String    @db.VarChar(100)
  entity_id   Int
  old_values  String?   @db.LongText
  new_values  String?   @db.LongText
  ip_address  String?   @db.VarChar(45)
  created_at  DateTime  @default(now()) @db.DateTime(0)
  deleted_at  DateTime? @db.DateTime(0)
  stores      stores?   @relation(fields: [store_id], references: [id], map: "fk_audit_logs_store")

  @@index([store_id], map: "fk_audit_logs_store")
  @@index([user_id], map: "fk_audit_logs_user")
}

model customer_meta {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique(map: "uuid") @default(uuid()) @db.Char(36)

  customer_id Int

  meta_key    String    @db.VarChar(100)
  meta_value  String?   @db.Text

  created_at  DateTime  @default(now()) @db.DateTime(0)
  deleted_at  DateTime? @db.DateTime(0)
  
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, map: "fk_customer_meta_customer")

  @@index([customer_id], map: "fk_customer_meta_customer")
  @@unique([customer_id, meta_key])
}

model customers {
  id            Int             @id @default(autoincrement())
  uuid          String          @unique(map: "uuid") @default(uuid()) @db.Char(36)

  name          String?         @db.VarChar(150)
  phone_no      String?         @db.VarChar(20) @unique
  email         String?         @db.VarChar(150)
 
  dob           DateTime?       @db.Date
  address       String?         @db.VarChar(255)
  city          String?         @db.VarChar(100)
  state         String?         @db.VarChar(100)
  status        Boolean         @default(true)

  created_at    DateTime        @default(now()) @db.DateTime(0)
  deleted_at    DateTime?       @db.DateTime(0)

  customer_meta customer_meta[]
  orders        orders[]
}

model order_items {
  id                    Int                   @id @default(autoincrement())
  uuid                  String                @unique(map: "uuid") @default(uuid()) @db.Char(36)
  order_id              Int
  batch_id              Int
  store_product_id      Int
  quantity              Decimal               @db.Decimal(12, 2)
  unit_price            Decimal               @db.Decimal(12, 2)
  subtotal              Decimal               @db.Decimal(12, 2)
  discount              Decimal               @default(0.00) @db.Decimal(12, 2)
  final_amount          Decimal               @db.Decimal(12, 2)
  created_at            DateTime              @default(now()) @db.DateTime(0)
  deleted_at            DateTime?             @db.DateTime(0)
  store_product_batches store_product_batches @relation(fields: [batch_id], references: [id], map: "fk_order_items_batch")
  orders                orders                @relation(fields: [order_id], references: [id], map: "fk_order_items_order")
  store_products        store_products        @relation(fields: [store_product_id], references: [id], map: "fk_order_items_store_product")

  @@index([batch_id], map: "fk_order_items_batch")
  @@index([order_id], map: "fk_order_items_order")
  @@index([store_product_id], map: "fk_order_items_store_product")
}

model order_transactions {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique(map: "uuid") @default(uuid()) @db.Char(36)
  order_id       Int
  transaction_id String?   @db.VarChar(100)
  amount         Decimal   @db.Decimal(12, 2)
  status         String    @db.VarChar(50)
  created_at     DateTime  @default(now()) @db.DateTime(0)
  deleted_at     DateTime? @db.DateTime(0)
  orders         orders    @relation(fields: [order_id], references: [id], map: "fk_order_transactions_order")

  @@index([order_id], map: "fk_order_transactions_order")
}

model orders {
  id                 Int                  @id @default(autoincrement())
  uuid               String               @unique(map: "uuid") @default(uuid()) @db.Char(36)
  customer_id        Int?
  store_id           Int
  order_date         DateTime             @db.DateTime(0)
  amount             Decimal              @default(0.00) @db.Decimal(12, 2)
  subtotal           Decimal              @default(0.00) @db.Decimal(12, 2)
  final_amount       Decimal              @default(0.00) @db.Decimal(12, 2)
  discount           Decimal              @default(0.00) @db.Decimal(12, 2)
  tax_amount         Decimal              @default(0.00) @db.Decimal(12, 2)
  status             String               @db.VarChar(50)
  payment_method     String?              @db.VarChar(50)
  transaction_id     String?              @db.VarChar(100)
  created_at         DateTime             @default(now()) @db.DateTime(0)
  deleted_at         DateTime?            @db.DateTime(0)
  order_items        order_items[]
  order_transactions order_transactions[]
  customers          customers?           @relation(fields: [customer_id], references: [id], map: "fk_orders_customer")
  stores             stores               @relation(fields: [store_id], references: [id], map: "fk_orders_store")

  @@index([customer_id], map: "fk_orders_customer")
  @@index([store_id], map: "fk_orders_store")
}

model purchase_order_items {
  id                    Int                   @id @default(autoincrement())
  uuid                  String                @unique(map: "uuid") @default(uuid()) @db.Char(36)
  purchase_order_id     Int
  batch_id              Int
  product_id            Int
  quantity              Decimal               @db.Decimal(12, 2)
  unit_per_pack         Decimal?              @db.Decimal(12, 2)
  base_quantity         Decimal?              @db.Decimal(12, 2)
  unit_cost             Decimal               @db.Decimal(12, 2)
  subtotal              Decimal               @db.Decimal(12, 2)
  created_at            DateTime              @default(now()) @db.DateTime(0)
  deleted_at            DateTime?             @db.DateTime(0)
  store_product_batches store_product_batches @relation(fields: [batch_id], references: [id], map: "fk_purchase_order_items_batch")
  purchase_orders       purchase_orders       @relation(fields: [purchase_order_id], references: [id], map: "fk_purchase_order_items_order")
  products              products              @relation(fields: [product_id], references: [id], map: "fk_purchase_order_items_product")

  @@index([batch_id], map: "fk_purchase_order_items_batch")
  @@index([purchase_order_id], map: "fk_purchase_order_items_order")
  @@index([product_id], map: "fk_purchase_order_items_product")
}

model purchase_order_transactions {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique(map: "uuid") @default(uuid()) @db.Char(36)
  purchase_order_id Int
  transaction_id    String?         @db.VarChar(100)
  amount            Decimal         @db.Decimal(12, 2)
  status            String          @db.VarChar(50)
  created_at        DateTime        @default(now()) @db.DateTime(0)
  deleted_at        DateTime?       @db.DateTime(0)
  purchase_orders   purchase_orders @relation(fields: [purchase_order_id], references: [id], map: "fk_purchase_order_transactions_order")

  @@index([purchase_order_id], map: "fk_purchase_order_transactions_order")
}

model purchase_orders {
  id                          Int                           @id @default(autoincrement())
  uuid                        String                        @unique(map: "uuid") @default(uuid()) @db.Char(36)
  supplier_id                 Int
  store_id                    Int
  purchase_date               DateTime                      @db.DateTime(0)
  amount                      Decimal                       @default(0.00) @db.Decimal(12, 2)
  subtotal                    Decimal                       @default(0.00) @db.Decimal(12, 2)
  final_amount                Decimal                       @default(0.00) @db.Decimal(12, 2)
  discount                    Decimal                       @default(0.00) @db.Decimal(12, 2)
  tax_amount                  Decimal                       @default(0.00) @db.Decimal(12, 2)
  status                      String                        @db.VarChar(50)
  payment_method              String?                       @db.VarChar(50)
  created_at                  DateTime                      @default(now()) @db.DateTime(0)
  deleted_at                  DateTime?                     @db.DateTime(0)
  purchase_order_items        purchase_order_items[]
  purchase_order_transactions purchase_order_transactions[]
  stores                      stores                        @relation(fields: [store_id], references: [id], map: "fk_purchase_orders_store")
  suppliers                   suppliers                     @relation(fields: [supplier_id], references: [id], map: "fk_purchase_orders_supplier")

  @@index([store_id], map: "fk_purchase_orders_store")
  @@index([supplier_id], map: "fk_purchase_orders_supplier")
}

model supplier_meta {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique(map: "uuid") @default(uuid()) @db.Char(36)
  supplier_id Int
  meta_key    String    @db.VarChar(100)
  meta_value  String?   @db.Text
  created_at  DateTime  @default(now()) @db.DateTime(0)
  deleted_at  DateTime? @db.DateTime(0)
  suppliers   suppliers @relation(fields: [supplier_id], references: [id], onDelete: Cascade, map: "fk_supplier_meta_supplier")

  @@index([supplier_id], map: "fk_supplier_meta_supplier")
}

model suppliers {
  id                    Int                     @id @default(autoincrement())
  uuid                  String                  @unique(map: "uuid") @default(uuid()) @db.Char(36)
  name                  String                  @db.VarChar(150)
  phone_no              String?                 @db.VarChar(20)
  email                 String?                 @db.VarChar(150)
  address               String?                 @db.VarChar(255)
  city                  String?                 @db.VarChar(100)
  state                 String?                 @db.VarChar(100)
  pincode               String?                 @db.VarChar(10)
  status                Boolean                 @default(true)
  tax                   String?                 @db.VarChar(100)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  deleted_at            DateTime?               @db.DateTime(0)
  purchase_orders       purchase_orders[]
  store_product_batches store_product_batches[]
  supplier_meta         supplier_meta[]
}

enum Status {
  active
  inactive
}

enum stores_status {
  open
  closed
  suspended
  license_expired
}
